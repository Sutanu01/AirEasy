{
  "name": "api_gateway",
  "version": "1.0.0",
  "description": "API Gateway for Airline Microservices",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node --dns-result-order=ipv4first dist/index.js",
    "dev": "tsc -w & nodemon dist/index.js",
    "prisma:generate": "prisma generate --config ./prisma.config.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "http-status-codes": "^2.3.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "nodemon": "^3.0.2",
    "prisma": "^7.6.0",
    "typescript": "^5.3.2"
  }
}
