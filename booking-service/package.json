    "prisma:generate": "prisma generate --config ./prisma.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "http-status-codes": "^2.2.0",
    "pg": "^8.20.0",
    "winston": "^3.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.0",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.10",
    "prisma": "^7.6.0",
    "typescript": "^5.9.3"
  }
}
