{
  "name": "booking_service",
  "version": "1.0.0",
  "description": "Booking service for the airline system",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --dns-result-order=ipv4first dist/index.js",
    "dev": "concurrently \"tsc -w\" \"nodemon --watch dist dist/index.js\"",
    "prisma:generate": "prisma generate --config ./prisma.config.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@types/amqplib": "^0.10.8",
    "@types/node-cron": "^3.0.11",
    "amqplib": "^2.0.1",
    "axios": "^1.18.1",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "http-status-codes": "^2.2.0",
    "node-cron": "^4.5.0",
    "pg": "^8.20.0",
    "winston": "^3.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.0",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.10",
    "prisma": "^7.6.0",
    "typescript": "^5.9.3"
  }
}
