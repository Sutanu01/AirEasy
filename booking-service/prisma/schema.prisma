generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  PENDING   @map("pending")
  BOOKED    @map("booked")
  CANCELLED @map("cancelled")
}

model Booking {
  id        Int           @id @default(autoincrement())
  flightId  Int
  userId    Int
  status    BookingStatus @default(PENDING)
  noOfSeats Int
  totalCost Int

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([flightId])
  @@map("bookings")
}

