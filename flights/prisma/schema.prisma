generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Airplane{
  id            Int      @id @default(autoincrement())
  modelNumber   String
  capacity      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@map("airplanes")
}

model City{
  id           Int      @id @default(autoincrement())
  cityName     String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  @@map("cities")
}
