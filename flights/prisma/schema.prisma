generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Airplane {
  id          Int      @id @default(autoincrement())
  modelNumber String
  capacity    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  flights     Flight[]
  seats       Seat[]

  @@map("airplanes")
}

model City {
  id        Int       @id @default(autoincrement())
  cityName  String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  airports  Airport[]

  @@map("cities")
}

model Airport {
  id               Int      @id @default(autoincrement())
  airportName      String   @unique
  airportCode      String   @unique
  address          String?
  cityId           Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  city             City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  arrivalFlights   Flight[] @relation("Arrival")
  departureFlights Flight[] @relation("Departure")

  @@index([cityId])
  @@map("airports")
}

model Flight {
  id                 Int      @id @default(autoincrement())
  flightNumber       String   @unique
  airplaneId         Int
  departureTime      DateTime
  arrivalTime        DateTime
  departureAirportId Int
  arrivalAirportId   Int
  price              Float
  boardingGate       String?
  availableSeats     Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
  airplane           Airplane @relation(fields: [airplaneId], references: [id], onDelete: Cascade)
  arrivalAirport     Airport  @relation("Arrival", fields: [arrivalAirportId], references: [id], onDelete: Cascade)
  departureAirport   Airport  @relation("Departure", fields: [departureAirportId], references: [id], onDelete: Cascade)

  @@index([departureAirportId])
  @@index([arrivalAirportId])
  @@index([airplaneId])
  @@map("flights")
}

model Seat {
  id         Int      @id @default(autoincrement())
  airplaneId Int
  row        Int
  column     String
  seatType   SeatType @default(ECONOMY)
  airplane   Airplane @relation(fields: [airplaneId], references: [id], onDelete: Cascade)

  @@index([airplaneId])
  @@map("seats")
}

enum SeatType {
  FIRST_CLASS     @map("first_class")
  BUSINESS        @map("business")
  PREMIUM_ECONOMY @map("premium_economy")
  ECONOMY         @map("economy")
}
