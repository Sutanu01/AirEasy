generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Airplane{
  id            Int      @id @default(autoincrement())
  modelNumber   String
  capacity      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@map("airplanes")
}

model City{
  id           Int      @id @default(autoincrement())
  cityName     String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  airports     Airport[]

  @@map("cities")
}

model Airport{
  id           Int      @id @default(autoincrement())
  airportName  String   @unique
  airportCode  String   @unique
  address      String?
  cityId       Int
  city         City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  
  @@index([cityId])
  @@map("airports")
}