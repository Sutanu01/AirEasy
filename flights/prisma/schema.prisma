generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Airplane {
  id          Int      @id @default(autoincrement())
  modelNumber String
  capacity    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  flights     Flight[]
  seats       Seat[]

  @@map("airplanes")
}

model City {
  id        Int       @id @default(autoincrement())
  cityName  String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  airports  Airport[]

  @@map("cities")
}

model Airport {
  id          Int     @id @default(autoincrement())
  airportName String  @unique
  airportCode String  @unique
  address     String?
  cityId      Int

  city             City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  departureFlights Flight[] @relation("Departure")
  arrivalFlights   Flight[] @relation("Arrival")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([cityId])
  @@map("airports")
}

model Flight {
  id                 Int      @id @default(autoincrement())
  flightNumber       String   @unique
  airplaneId         Int
  departureTime      DateTime
  arrivalTime        DateTime
  departureAirportId Int
  arrivalAirportId   Int
  price              Float
  boardingGate       String?
  availableSeats     Int

  airplane         Airplane @relation(fields: [airplaneId], references: [id], onDelete: Cascade)
  departureAirport Airport  @relation("Departure", fields: [departureAirportId], references: [id], onDelete: Cascade)
  arrivalAirport   Airport  @relation("Arrival", fields: [arrivalAirportId], references: [id], onDelete: Cascade)
  bookings         Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([departureAirportId])
  @@index([arrivalAirportId])
  @@index([airplaneId])
  @@map("flights")
}

enum SeatType {
  FIRST_CLASS     @map("first_class")
  BUSINESS        @map("business")
  PREMIUM_ECONOMY @map("premium_economy")
  ECONOMY         @map("economy")
}

model Seat {
  id         Int      @id @default(autoincrement())
  airplaneId Int
  row        Int
  column     String
  seatType   SeatType @default(ECONOMY)

  airplane Airplane @relation(fields: [airplaneId], references: [id], onDelete: Cascade)

  @@index([airplaneId])
  @@map("seats")
}

enum BookingStatus {
  PENDING    @map("pending")
  BOOKED     @map("booked")
  CANCELLED  @map("cancelled")
}

model Booking {
  id        Int           @id @default(autoincrement())
  flightId  Int
  userId    Int
  status    BookingStatus @default(PENDING)
  noOfSeats Int
  totalCost Int

  flight Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([flightId])
  @@map("bookings")
}


